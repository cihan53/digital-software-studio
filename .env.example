# ==============================================================================
# Digital Software Studio — Çevre Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı .env olarak kopyalayıp ihtiyacınıza göre düzenleyebilirsiniz:
# cp .env.example .env
#
# DİKKAT: .env dosyanızı ASLA git reposuna eklemeyin (.gitignore kuralı mevcuttur).
# ==============================================================================

# LLM API Anahtarları (Kullanmak istediğiniz modeli seçebilirsiniz)
# Google Gemini (Önerilen varsayılan)
GEMINI_API_KEY=

# Anthropic Claude (Opsiyonel)
ANTHROPIC_API_KEY=

# OpenAI GPT (Opsiyonel)
OPENAI_API_KEY=

# GitHub Entegrasyonu (gh CLI oturumu varsa otomatik kullanılır)
# GITHUB_TOKEN=

# ==============================================================================
# Çalıştırma Arka Ucu (Backend) Seçimi
# ==============================================================================
# STUDIO_BACKEND: agy (Antigravity/Gemini — varsayılan) veya devin (Devin AI)
# STUDIO_BACKEND=agy

# Devin AI backend ayarları (STUDIO_BACKEND=devin iken geçerli)
# STUDIO_DEVIN_MODEL: Devin model adı (ör. swe-2, opus, codex). Boş = hesap varsayılanı
# STUDIO_DEVIN_MODEL=
# STUDIO_DEVIN_CLOUD=1 → oturumları Devin Cloud VM'inde çalıştırır (Devin hesabı gerekir)
# STUDIO_DEVIN_CLOUD=0
# STUDIO_DEVIN_TIMEOUT=3600
# Araç kullanan roller için izin modu: auto | accept-edits | smart | dangerous
# STUDIO_DEVIN_PERMISSION_MODE=dangerous
